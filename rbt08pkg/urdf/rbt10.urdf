<?xml version="1.0"?>
<robot name="rbt10" xmlns:xacro="http://www.ros.org/wiki/xacro">

<xacro:arg name="enable_gz_ros2_control" default="false"/>
<xacro:arg name="enable_physical_grasp" default="true"/>
<xacro:arg name="enable_camera" default="false"/>

<!-- questo è un commento -->
<xacro:include filename="$(find rbt08pkg)/urdf/rbt10.gazebo"/>
<xacro:include filename="$(find rbt08pkg)/urdf/gripper.urdf.xacro"/>



<link name="world"></link>

<link name="base_link">
    <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
            <!--mesh filename="file://$(find rbt08pkg)/meshes/Exe070101Prt.dae"/-->
            <!--mesh filename="$(find rbt08pkg)/meshes/Exe070101Prt.dae"/-->
            <mesh filename="package://rbt08pkg/meshes/Exe070101Prt.dae"/>
        </geometry>
    </visual>

    <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
            <!--mesh filename="file://$(find rbt08pkg)/meshes/Exe070101Prt.dae"/-->
            <!--mesh filename="$(find rbt08pkg)/meshes/Exe070101Prt.dae"/-->
            <mesh filename="package://rbt08pkg/meshes/Exe070101Prt.dae"/>
        </geometry>
    </collision>

    <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.001" />
        <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001" />
    </inertial>
</link>

<link name="link1">
    <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
            <!--mesh filename="file://$(find rbt08pkg)/meshes/Exe070102Prt.dae"/-->
            <!--mesh filename="$(find rbt08pkg)/meshes/Exe070102Prt.dae"/-->
            <mesh filename="package://rbt08pkg/meshes/Exe070102Prt.dae"/>
        </geometry>
    </visual>

    <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
            <!--mesh filename="file://$(find rbt08pkg)/meshes/Exe070102Prt.dae"/-->
            <!--mesh filename="$(find rbt08pkg)/meshes/Exe070102Prt.dae"/-->
            <mesh filename="package://rbt08pkg/meshes/Exe070102Prt.dae"/>
        </geometry>
    </collision>

    <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.001" />
        <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001" />
    </inertial>

</link>

<link name="link2">
    <visual>
        <origin xyz="0 0 0" rpy="3.1416 0 0"/>
        <geometry>
            <!--mesh filename="file://$(find rbt08pkg)/meshes/Exe070103Prt.dae"/-->
            <!--mesh filename="$(find rbt08pkg)/meshes/Exe070103Prt.dae"/-->
            <mesh filename="package://rbt08pkg/meshes/Exe070103Prt.dae"/>
        </geometry>
    </visual>

    <collision>
        <origin xyz="0 0 0" rpy="3.1416 0 0"/>
        <geometry>
            <!--mesh filename="file://$(find rbt08pkg)/meshes/Exe070103Prt.dae"/-->
            <!--mesh filename="$(find rbt08pkg)/meshes/Exe070103Prt.dae"/-->
            <mesh filename="package://rbt08pkg/meshes/Exe070103Prt.dae"/>
        </geometry>
    </collision>

    <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.001" />
        <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001" />
    </inertial>

</link>

<link name="link3">
    <visual>
        <origin xyz="0 0 0" rpy="1.5707 0 1.5707"/>
        <!--origin xyz="0 0 0" rpy="0 0 0"/-->
        <geometry>
            <!--mesh filename="file://$(find rbt08pkg)/meshes/Exe070104Prt.dae"/-->
            <!--mesh filename="$(find rbt08pkg)/meshes/Exe070104Prt.dae"/-->
            <mesh filename="package://rbt08pkg/meshes/Exe070104Prt.dae"/>
        </geometry>
    </visual>

    <collision>
        <origin xyz="0 0 0" rpy="1.5707 0 1.5707"/>
        <geometry>
            <!--mesh filename="file://$(find rbt08pkg)/meshes/Exe070104Prt.dae"/-->
            <!--mesh filename="$(find rbt08pkg)/meshes/Exe070104Prt.dae"/-->
            <mesh filename="package://rbt08pkg/meshes/Exe070104Prt.dae"/>
        </geometry>
    </collision>

    <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.001" />
        <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001" />
    </inertial>

</link>

<link name="link4">
    <visual>
        <origin xyz="0 0 0" rpy="0 -1.5707 3.1416"/>
        <geometry>
            <!--mesh filename="file://$(find rbt08pkg)/meshes/Exe070105Prt.dae"/-->
            <!--mesh filename="$(find rbt08pkg)/meshes/Exe070105Prt.dae"/-->
            <mesh filename="package://rbt08pkg/meshes/Exe070105Prt.dae"/>
        </geometry>
    </visual>

    <collision>
        <origin xyz="0 0 0" rpy="0 -1.5707 3.1416"/>
        <geometry>
            <!--mesh filename="file://$(find rbt08pkg)/meshes/Exe070105Prt.dae"/-->
            <!--mesh filename="$(find rbt08pkg)/meshes/Exe070105Prt.dae"/-->
            <mesh filename="package://rbt08pkg/meshes/Exe070105Prt.dae"/>
        </geometry>
    </collision>

    <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.001" />
        <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001" />
    </inertial>

</link>

<link name="link5">
    <visual>
        <origin xyz="0 0 0" rpy="-1.5707 0 0"/>
        <geometry>
            <!--mesh filename="file://$(find rbt08pkg)/meshes/Exe070106Prt.dae"/-->
            <!--mesh filename="$(find rbt08pkg)/meshes/Exe070106Prt.dae"/-->
            <mesh filename="package://rbt08pkg/meshes/Exe070106Prt.dae"/>
        </geometry>
    </visual>

    <collision>
        <origin xyz="0 0 0" rpy="-1.5707 0 0"/>
        <geometry>
            <!--mesh filename="file://$(find rbt08pkg)/meshes/Exe070106Prt.dae"/-->
            <!--mesh filename="$(find rbt08pkg)/meshes/Exe070106Prt.dae"/-->
            <mesh filename="package://rbt08pkg/meshes/Exe070106Prt.dae"/>
        </geometry>
    </collision>

    <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.001" />
        <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001" />
    </inertial>

</link>

<link name="link6">
    <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
            <!--mesh filename="file://$(find rbt08pkg)/meshes/Exe070107Prt.dae"/-->
            <!--mesh filename="$(find rbt08pkg)/meshes/Exe070107Prt.dae"/-->
            <mesh filename="package://rbt08pkg/meshes/Exe070107Prt.dae"/>
        </geometry>
    </visual>

    <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
            <!--mesh filename="file://$(find rbt08pkg)/meshes/Exe070107Prt.dae"/-->
            <!--mesh filename="$(find rbt08pkg)/meshes/Exe070107Prt.dae"/-->
            <mesh filename="package://rbt08pkg/meshes/Exe070107Prt.dae"/>
        </geometry>
    </collision>

    <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.001" />
        <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001" />
    </inertial>

</link>

<joint name="worldtobase" type="fixed">
    <parent link="world" />
    <child link="base_link" />
    <origin rpy="0 0 0" xyz="0 0 0" />
</joint>

<joint name="j1" type="revolute">
    <parent link="base_link"/>
    <child link="link1"/>
    <axis xyz="0 0 1"/>
    <limit effort="1000.0" lower="-3.1415" upper="3.1415" velocity="0.5"/>
    <origin rpy="0 0 0" xyz="0 0 0.18"/>
</joint>

<joint name="j2" type="revolute">
    <parent link="link1"/>
    <child link="link2"/>
    <axis xyz="0 0 1"/>
    <limit effort="100000.0" lower="-3.1415" upper="3.1415" velocity="0.5"/>
    <origin rpy="-1.5707 -1.5707 0" xyz="0 -0.155 0.15"/>
</joint>

<joint name="j3" type="revolute">
    <parent link="link2"/>
    <child link="link3"/>
    <axis xyz="0 0 1"/>
    <limit effort="100000.0" lower="-3.1415" upper="3.1415" velocity="0.5"/>
    <origin rpy="0 0 0" xyz="0.7 0 0.155"/>
</joint>

<joint name="j4" type="revolute">
    <parent link="link3"/>
    <child link="link4"/>
    <axis xyz="0 0 1"/>
    <limit effort="1000.0" lower="-3.1415" upper="3.1415" velocity="0.5"/>
    <origin rpy="-1.5707 0 0" xyz="0.16 0.205 0"/>
</joint>

<joint name="j5" type="revolute">
    <parent link="link4"/>
    <child link="link5"/>
    <axis xyz="0 0 1"/>
    <limit effort="1000.0" lower="-3.1415" upper="3.1415" velocity="0.5"/>
    <origin rpy="-1.5707 -1.5707 0" xyz="0 0 0.65"/>
</joint>

<joint name="j6" type="revolute">
    <parent link="link5"/>
    <child link="link6"/>
    <axis xyz="0 0 1"/>
    <limit effort="1000.0" lower="-3.1415" upper="3.1415" velocity="0.5"/>
    <origin rpy="1.5707 0 0" xyz="0.2 -0.18 0"/>
</joint>

<!-- STEP 12 - Table camera -->
<joint type="fixed" name="table_camera_joint">
    <!-- Rear/raised view: +X points at the pear, above the initial arm silhouette. -->
    <origin xyz="0.15 -0.55 1.75" rpy="0 0.3323335118 1.0040671093"/>
    <child link="table_camera_link"/>
    <parent link="world"/>
</joint>

<joint type="fixed" name="table_camera_optical_joint">
    <!-- ROS optical axes: +Z forward, +X right, +Y down. -->
    <origin xyz="0 0 0" rpy="-1.5707963267948966 0 -1.5707963267948966"/>
    <child link="table_camera_link_optical"/>
    <parent link="table_camera_link"/>
</joint>

<link name='table_camera_link'>
    <pose>0 0 0 0 0 0</pose>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size=".05 .05 .05"/>
      </geometry>
      <material name="table_camera_red">
        <color rgba="0.8 0.1 0.1 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size=".05 .05 .05"/>
      </geometry>
    </collision>
  
    <inertial>
      <mass value="1.0e-03"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia
          ixx="1e-6" ixy="0" ixz="0"
          iyy="1e-6" iyz="0"
          izz="1e-6"
      />
    </inertial>
</link>

<link name="table_camera_link_optical">
</link>

  



</robot>
