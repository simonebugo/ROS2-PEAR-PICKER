<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!--
    Simple parallel gripper for the first harvesting prototype.
    A positive command closes both fingers symmetrically towards the centre.
    The contact surfaces are intentionally broad to distribute pressure on a pear.
  -->
  <link name="gripper_base_link">
    <visual>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry><box size="0.14 0.22 0.10"/></geometry>
      <material name="gripper_dark"><color rgba="0.18 0.18 0.20 1"/></material>
    </visual>
    <collision name="gripper_base_collision">
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry><box size="0.14 0.22 0.10"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <mass value="0.50"/>
      <inertia ixx="0.0015" ixy="0" ixz="0" iyy="0.0009" iyz="0" izz="0.0015"/>
    </inertial>
  </link>

  <joint name="gripper_mount_joint" type="fixed">
    <parent link="link6"/>
    <child link="gripper_base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="left_finger_link">
    <visual>
      <origin xyz="0 0 0.09" rpy="0 0 0"/>
      <geometry><box size="0.035 0.026 0.18"/></geometry>
      <material name="gripper_pad"><color rgba="0.75 0.35 0.08 1"/></material>
    </visual>
    <collision name="left_finger_collision">
      <origin xyz="0 0 0.09" rpy="0 0 0"/>
      <geometry><box size="0.035 0.026 0.18"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.09" rpy="0 0 0"/>
      <mass value="0.10"/>
      <inertia ixx="0.0003" ixy="0" ixz="0" iyy="0.0003" iyz="0" izz="0.00002"/>
    </inertial>
  </link>

  <joint name="left_finger_joint" type="prismatic">
    <parent link="gripper_base_link"/>
    <child link="left_finger_link"/>
    <origin xyz="0 0.10 0.10" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <limit lower="0.0" upper="0.075" effort="40" velocity="0.03"/>
  </joint>

  <link name="right_finger_link">
    <visual>
      <origin xyz="0 0 0.09" rpy="0 0 0"/>
      <geometry><box size="0.035 0.026 0.18"/></geometry>
      <material name="gripper_pad"/>
    </visual>
    <collision name="right_finger_collision">
      <origin xyz="0 0 0.09" rpy="0 0 0"/>
      <geometry><box size="0.035 0.026 0.18"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.09" rpy="0 0 0"/>
      <mass value="0.10"/>
      <inertia ixx="0.0003" ixy="0" ixz="0" iyy="0.0003" iyz="0" izz="0.00002"/>
    </inertial>
  </link>

  <joint name="right_finger_joint" type="prismatic">
    <parent link="gripper_base_link"/>
    <child link="right_finger_link"/>
    <origin xyz="0 -0.10 0.10" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0.0" upper="0.075" effort="40" velocity="0.03"/>
  </joint>

  <!-- Centre of the grasp; use this frame as the target pose in MoveIt. -->
  <link name="grasp_frame"/>
  <joint name="grasp_frame_joint" type="fixed">
    <parent link="gripper_base_link"/>
    <child link="grasp_frame"/>
    <origin xyz="0 0 0.19" rpy="0 0 0"/>
  </joint>
</robot>
