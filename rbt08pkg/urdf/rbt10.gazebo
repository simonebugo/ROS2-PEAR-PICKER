<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <gazebo>
        <plugin
            filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
            <topic>joint_states</topic>
            <joint_name>j1</joint_name>
            <joint_name>j2</joint_name>
            <joint_name>j3</joint_name>
            <joint_name>j4</joint_name>
            <joint_name>j5</joint_name>
            <joint_name>j6</joint_name>
            <joint_name>left_finger_joint</joint_name>
            <joint_name>right_finger_joint</joint_name>
        </plugin>
    </gazebo>

    <xacro:if value="$(arg enable_physical_grasp)">
        <gazebo>
            <!-- grasp_frame_joint is explicitly preserved during URDF-to-SDF
                 conversion, so this origin is the physical grasp centre. -->
            <plugin filename="gz-sim-detachable-joint-system" name="gz::sim::systems::DetachableJoint">
                <parent_link>grasp_frame</parent_link>
                <child_model>pear</child_model>
                <child_link>pear_link</child_link>
                <attach_topic>/harvest/gripper/attach</attach_topic>
                <detach_topic>/harvest/gripper/detach</detach_topic>
                <output_topic>/harvest/gripper/state</output_topic>
            </plugin>
        </gazebo>
    </xacro:if>

    <gazebo reference="left_finger_link">
        <mu1>1.2</mu1>
        <mu2>1.2</mu2>
        <sensor name="left_finger_contact" type="contact">
            <always_on>true</always_on>
            <update_rate>100</update_rate>
            <topic>/harvest/contacts/left</topic>
            <contact><collision>left_finger_collision</collision></contact>
        </sensor>
    </gazebo>

    <gazebo reference="right_finger_link">
        <mu1>1.2</mu1>
        <mu2>1.2</mu2>
        <sensor name="right_finger_contact" type="contact">
            <always_on>true</always_on>
            <update_rate>100</update_rate>
            <topic>/harvest/contacts/right</topic>
            <contact><collision>right_finger_collision</collision></contact>
        </sensor>
    </gazebo>

    <xacro:if value="$(arg enable_gz_ros2_control)">
        <gazebo>
            <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
                <parameters>$(find rbt08pkg)/config/controller_position.yaml</parameters>
            </plugin>
        </gazebo>
    </xacro:if>

    <xacro:if value="$(arg enable_gz_ros2_control)">
      <ros2_control name="GazeboSystem" type="system">
          <hardware>
              <plugin>gz_ros2_control/GazeboSimSystem</plugin>
          </hardware>
    
        <joint name="j1">
            <command_interface name="position">
            <param name="min">-3.1415</param>
            <param name="max">3.1415</param>
            </command_interface>
            <state_interface name="position">
            <param name="initial_value">0.0</param>
            </state_interface>
            <state_interface name="velocity"/>
            <state_interface name="effort"/>
        </joint>

        <joint name="j2">
            <command_interface name="position">
            <param name="min">-3.1415</param>
            <param name="max">3.1415</param>
            </command_interface>
            <state_interface name="position">
            <param name="initial_value">0.0</param>
            </state_interface>
            <state_interface name="velocity"/>
            <state_interface name="effort"/>
        </joint>

        <joint name="j3">
            <command_interface name="position">
            <param name="min">-3.1415</param>
            <param name="max">3.1415</param>
            </command_interface>
            <state_interface name="position">
            <param name="initial_value">0.0</param>
            </state_interface>
            <state_interface name="velocity"/>
            <state_interface name="effort"/>
        </joint>

        <joint name="j4">
            <command_interface name="position">
            <param name="min">-3.1415</param>
            <param name="max">3.1415</param>
            </command_interface>
            <state_interface name="position">
            <param name="initial_value">0.0</param>
            </state_interface>
            <state_interface name="velocity"/>
            <state_interface name="effort"/>
        </joint>

        <joint name="j5">
            <command_interface name="position">
            <param name="min">-3.1415</param>
            <param name="max">3.1415</param>
            </command_interface>
            <state_interface name="position">
            <param name="initial_value">0.0</param>
            </state_interface>
            <state_interface name="velocity"/>
            <state_interface name="effort"/>
        </joint>

        <joint name="j6">
            <command_interface name="position">
            <param name="min">-3.1415</param>
            <param name="max">3.1415</param>
            </command_interface>
            <state_interface name="position">
            <param name="initial_value">0.0</param>
            </state_interface>
            <state_interface name="velocity"/>
            <state_interface name="effort"/>
        </joint>

        <joint name="left_finger_joint">
            <command_interface name="position">
            <param name="min">0.0</param>
            <param name="max">0.075</param>
            </command_interface>
            <state_interface name="position">
            <param name="initial_value">0.0</param>
            </state_interface>
            <state_interface name="velocity"/>
        </joint>

        <joint name="right_finger_joint">
            <command_interface name="position">
            <param name="min">0.0</param>
            <param name="max">0.075</param>
            </command_interface>
            <state_interface name="position">
            <param name="initial_value">0.0</param>
            </state_interface>
            <state_interface name="velocity"/>
        </joint>

      </ros2_control>
    </xacro:if>

    <gazebo reference="table_camera_link">
    <sensor name="camera" type="camera">
      <camera>
        <horizontal_fov>1.3962634</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>15</far>
        </clip>
        <noise>
          <type>gaussian</type>
          <!-- Noise is sampled independently per pixel on each frame.
               That pixel's noise value is added to each of its color
               channels, which at that point lie in the range [0,1]. -->
          <mean>0.0</mean>
          <stddev>0.007</stddev>
        </noise>
        <optical_frame_id>table_camera_link_optical</optical_frame_id>
        <camera_info_topic>table_camera/camera_info</camera_info_topic>
      </camera>
      <always_on>1</always_on>
      <update_rate>20</update_rate>
      <visualize>true</visualize>
      <topic>table_camera/image</topic>
    </sensor>
  </gazebo>

</robot>
