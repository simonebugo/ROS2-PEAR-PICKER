<?xml version="1.0" ?>
<sdf version="1.10">
  <world name="pear_orchard">
    <physics name="physics" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin name="gz::sim::systems::Physics" filename="gz-sim-physics-system"/>
    <plugin name="gz::sim::systems::UserCommands" filename="gz-sim-user-commands-system"/>
    <plugin name="gz::sim::systems::SceneBroadcaster" filename="gz-sim-scene-broadcaster-system"/>
    <plugin name="gz::sim::systems::Contact" filename="gz-sim-contact-system"/>

    <gravity>0 0 -9.81</gravity>
    <scene>
      <ambient>0.55 0.55 0.55 1</ambient>
      <background>0.68 0.82 0.96 1</background>
      <shadows>true</shadows>
    </scene>

    <model name="ground_plane">
      <static>true</static>
      <link name="ground_link">
        <collision name="ground_collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
        </collision>
        <visual name="ground_visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material><ambient>0.24 0.42 0.18 1</ambient><diffuse>0.24 0.42 0.18 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Static tree used as the collision geometry for the first scene. -->
    <model name="pear_tree">
      <static>true</static>
      <pose>1.0 0.6 0 0 0 0</pose>
      <!-- The pear is attached by GraspManager as soon as Gazebo starts. -->
      <plugin filename="gz-sim-detachable-joint-system" name="gz::sim::systems::DetachableJoint">
        <parent_link>tree_link</parent_link>
        <child_model>pear</child_model>
        <child_link>pear_link</child_link>
        <attach_topic>/harvest/tree/attach</attach_topic>
        <detach_topic>/harvest/tree/detach</detach_topic>
        <output_topic>/harvest/tree/state</output_topic>
      </plugin>
      <link name="tree_link">
        <collision name="trunk_collision">
          <pose>0 0 0.95 0 0 0</pose>
          <geometry><cylinder><radius>0.10</radius><length>1.90</length></cylinder></geometry>
        </collision>
        <visual name="trunk_visual">
          <pose>0 0 0.95 0 0 0</pose>
          <geometry><cylinder><radius>0.10</radius><length>1.90</length></cylinder></geometry>
          <material><ambient>0.26 0.12 0.04 1</ambient><diffuse>0.38 0.20 0.07 1</diffuse></material>
        </visual>
        <collision name="branch_collision">
          <pose>-0.27 0 1.65 0 1.10 0</pose>
          <geometry><cylinder><radius>0.045</radius><length>0.65</length></cylinder></geometry>
        </collision>
        <visual name="branch_visual">
          <pose>-0.27 0 1.65 0 1.10 0</pose>
          <geometry><cylinder><radius>0.045</radius><length>0.65</length></cylinder></geometry>
          <material><ambient>0.26 0.12 0.04 1</ambient><diffuse>0.38 0.20 0.07 1</diffuse></material>
        </visual>
        <!-- Lower branch supporting the fruit at a reachable height. -->
        <collision name="fruit_branch_collision">
          <pose>-0.22 0 1.30 0 1.5708 0</pose>
          <geometry><cylinder><radius>0.040</radius><length>0.50</length></cylinder></geometry>
        </collision>
        <visual name="fruit_branch_visual">
          <pose>-0.22 0 1.30 0 1.5708 0</pose>
          <geometry><cylinder><radius>0.040</radius><length>0.50</length></cylinder></geometry>
          <material><ambient>0.26 0.12 0.04 1</ambient><diffuse>0.38 0.20 0.07 1</diffuse></material>
        </visual>
        <visual name="canopy_left">
          <pose>-0.22 -0.12 1.95 0 0 0</pose>
          <geometry><sphere><radius>0.38</radius></sphere></geometry>
          <material><ambient>0.05 0.34 0.07 1</ambient><diffuse>0.08 0.50 0.11 1</diffuse></material>
        </visual>
        <visual name="canopy_right">
          <pose>0.22 0.14 1.95 0 0 0</pose>
          <geometry><sphere><radius>0.36</radius></sphere></geometry>
          <material><ambient>0.05 0.34 0.07 1</ambient><diffuse>0.08 0.50 0.11 1</diffuse></material>
        </visual>
        <visual name="canopy_top">
          <pose>0 0 2.25 0 0 0</pose>
          <geometry><sphere><radius>0.34</radius></sphere></geometry>
          <material><ambient>0.05 0.34 0.07 1</ambient><diffuse>0.08 0.50 0.11 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Dynamic pear. Its initial fixed joint to the lower branch is created
         by the detachable-joint system before the world is unpaused. -->
    <model name="pear">
      <static>false</static>
      <self_collide>false</self_collide>
      <pose>0.56 0.60 1.15 0 0 0</pose>
      <link name="pear_link">
        <inertial>
          <mass>0.30</mass>
          <inertia>
            <ixx>0.0015</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>0.0015</iyy>
            <iyz>0</iyz>
            <izz>0.0012</izz>
          </inertia>
        </inertial>
        <collision name="pear_body_collision">
          <geometry><sphere><radius>0.075</radius></sphere></geometry>
          <surface>
            <friction><ode><mu>0.80</mu><mu2>0.80</mu2></ode></friction>
            <bounce><restitution_coefficient>0.05</restitution_coefficient></bounce>
          </surface>
        </collision>
        <visual name="pear_body_visual">
          <geometry><sphere><radius>0.075</radius></sphere></geometry>
          <material><ambient>0.56 0.72 0.06 1</ambient><diffuse>0.72 0.90 0.10 1</diffuse></material>
        </visual>
        <collision name="pear_neck_collision">
          <pose>0 0 0.065 0 0 0</pose>
          <geometry><sphere><radius>0.052</radius></sphere></geometry>
          <surface>
            <friction><ode><mu>0.80</mu><mu2>0.80</mu2></ode></friction>
            <bounce><restitution_coefficient>0.05</restitution_coefficient></bounce>
          </surface>
        </collision>
        <visual name="pear_neck_visual">
          <pose>0 0 0.065 0 0 0</pose>
          <geometry><sphere><radius>0.052</radius></sphere></geometry>
          <material><ambient>0.56 0.72 0.06 1</ambient><diffuse>0.72 0.90 0.10 1</diffuse></material>
        </visual>
        <visual name="pear_stem_visual">
          <pose>0 0 0.14 0 0 0</pose>
          <geometry><cylinder><radius>0.009</radius><length>0.08</length></cylinder></geometry>
          <material><ambient>0.20 0.09 0.02 1</ambient><diffuse>0.30 0.15 0.03 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Fixed, open-top collection basket within the robot workspace. -->
    <model name="collection_basket">
      <static>true</static>
      <pose>0.65 -0.55 0 0 0 0</pose>
      <link name="basket_link">
        <collision name="basket_bottom_collision">
          <pose>0 0 0.02 0 0 0</pose>
          <geometry><box><size>0.32 0.32 0.04</size></box></geometry>
        </collision>
        <visual name="basket_bottom_visual">
          <pose>0 0 0.02 0 0 0</pose>
          <geometry><box><size>0.32 0.32 0.04</size></box></geometry>
          <material><ambient>0.32 0.16 0.05 1</ambient><diffuse>0.50 0.27 0.08 1</diffuse></material>
        </visual>
        <collision name="basket_left_wall_collision">
          <pose>0 0.145 0.13 0 0 0</pose>
          <geometry><box><size>0.32 0.03 0.22</size></box></geometry>
        </collision>
        <visual name="basket_left_wall_visual">
          <pose>0 0.145 0.13 0 0 0</pose>
          <geometry><box><size>0.32 0.03 0.22</size></box></geometry>
          <material><ambient>0.32 0.16 0.05 1</ambient><diffuse>0.50 0.27 0.08 1</diffuse></material>
        </visual>
        <collision name="basket_right_wall_collision">
          <pose>0 -0.145 0.13 0 0 0</pose>
          <geometry><box><size>0.32 0.03 0.22</size></box></geometry>
        </collision>
        <visual name="basket_right_wall_visual">
          <pose>0 -0.145 0.13 0 0 0</pose>
          <geometry><box><size>0.32 0.03 0.22</size></box></geometry>
          <material><ambient>0.32 0.16 0.05 1</ambient><diffuse>0.50 0.27 0.08 1</diffuse></material>
        </visual>
        <collision name="basket_front_wall_collision">
          <pose>0.145 0 0.13 0 0 0</pose>
          <geometry><box><size>0.03 0.26 0.22</size></box></geometry>
        </collision>
        <visual name="basket_front_wall_visual">
          <pose>0.145 0 0.13 0 0 0</pose>
          <geometry><box><size>0.03 0.26 0.22</size></box></geometry>
          <material><ambient>0.32 0.16 0.05 1</ambient><diffuse>0.50 0.27 0.08 1</diffuse></material>
        </visual>
        <collision name="basket_back_wall_collision">
          <pose>-0.145 0 0.13 0 0 0</pose>
          <geometry><box><size>0.03 0.26 0.22</size></box></geometry>
        </collision>
        <visual name="basket_back_wall_visual">
          <pose>-0.145 0 0.13 0 0 0</pose>
          <geometry><box><size>0.03 0.26 0.22</size></box></geometry>
          <material><ambient>0.32 0.16 0.05 1</ambient><diffuse>0.50 0.27 0.08 1</diffuse></material>
        </visual>
      </link>
    </model>

    <light name="sun" type="directional">
      <pose>0 0 10 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <intensity>1.0</intensity>
      <direction>-0.4 0.2 -0.9</direction>
    </light>
  </world>
</sdf>
